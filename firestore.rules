rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userEmail} {
      allow read, write: if true;
    }
    match /hotmart_logs/{logId} {
      allow read, write: if true;
    }
    match /app_settings/{settingId} {
      allow read, write: if true;
    }
    match /invite_codes/{codeId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
